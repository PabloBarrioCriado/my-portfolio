---
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="The page you are looking for could not be found. Head back to the home page to keep exploring my data science portfolio."
>
  <PageHero
    eyebrow="Error 404"
    title="Page not found."
    subtitle="The page you are looking for has been moved, renamed, or never existed. Let's get you back to the data."
    compact
  >
    <div class="buttons is-centered mt-5">
      <a class="button is-primary is-medium" href="/">Back to home</a>
      <a class="button is-medium is-outlined" href="/contact">Contact me</a>
    </div>
  </PageHero>
</BaseLayout>