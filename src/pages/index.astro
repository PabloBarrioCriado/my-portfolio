---
import LatestPosts from '../components/LatestPosts.astro';
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

// Structured data for a professional portfolio
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  description: site.description,
  url: site.url,
  email: site.email,
  jobTitle: 'Data Scientist'
};

const stats = [
  { value: '3', label: 'End-to-End Projects' },
  { value: 'Python', label: 'Primary Language' },
  { value: 'Data Science', label: 'ML & DL' },
  { value: '100%', label: 'Driven by impact' },
];
---

<BaseLayout title={site.name} description={site.description} schema={personSchema}>
  <PageHero
    eyebrow="Data Science · Machine Learning & Deep Learning · Prescriptive Analytics"
    title="From statistical foundations to intelligent systems."
    subtitle="I build end-to-end data solutions, transforming complex datasets into actionable insights and robust predictive models."
  >
    <div class="buttons mt-5">
      <a class="button is-primary is-medium" href="/blog">View Projects</a>
      <a class="button is-medium is-outlined" href="/about">More About Me</a>
    </div>

    <Fragment slot="aside">
      <div class="box aw-hero-box">
        <p class="aw-eyebrow mb-3">Core Tech Stack</p>
        <ul class="content">
          <li><strong>Languages</strong> — Python, R, SQL</li>
          <li><strong>Machine Learning</strong> — Scikit-learn, LightGBM, XGBoost...</li>
          <li><strong>Deep Learning</strong> — PyTorch, Keras, Optuna</li>
          <li><strong>Data & Apps</strong> — Pandas, Streamlit, Power BI</li>
        </ul>
        <p class="aw-form-note mt-4">Focused on predictive & prescriptive analytics.</p>
      </div>
    </Fragment>
  </PageHero>

  <section class="section aw-section" aria-label="Portfolio highlights">
    <div class="container">
      <div class="columns has-text-centered">
        {
          stats.map((stat) => (
            <div class="column">
              <span class="aw-stat-number">{stat.value}</span>
              <span class="aw-stat-label">{stat.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <LatestPosts />

</BaseLayout>