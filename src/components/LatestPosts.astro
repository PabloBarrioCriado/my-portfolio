---
// Self-contained "latest articles" section for the home page.
// Renders the three most recent blog posts and links to the full listing.
import BlogCard from './BlogCard.astro';
import { getCollection } from 'astro:content';
import { readingTime } from '../utils/reading-time';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<section class="section aw-section">
  <div class="container">
    <div class="aw-section-head">
      <p class="aw-eyebrow mb-2">Portfolio</p>
      <h2 class="title is-2">Featured Projects</h2>
      <p class="subtitle is-6">Detailed walkthroughs of my Machine Learning models, statistical analyses, and data-driven applications.</p>
    </div>

    {
      posts.length > 0 ? (
        <div class="columns">
          {
            posts.map((post) => (
              <div class="column is-4">
                <BlogCard
                  title={post.data.title}
                  description={post.data.description}
                  pubDate={post.data.pubDate}